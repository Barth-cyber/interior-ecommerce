# Example environment variables for local development and Render deployment

# Flask / session security
ADMIN_SECRET_KEY=change-me-to-a-secure-random-value
ADMIN_USERNAME=admin
# For production, set this to a secure hash instead of a raw password.
# Example: use werkzeug.security.generate_password_hash('YourPassword')
ADMIN_PASSWORD_HASH=
ADMIN_COOKIE_SECURE=false

# Application configuration
PYTHONUNBUFFERED=true

# MongoDB (optional)
MONGO_URI=

# Google Gemini / AI backend
GEMINI_API_KEY=

# AWS S3 upload storage (optional)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=
AWS_S3_REGION=

# Payment providers (optional)
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Social Media APIs (for automatic video fetching)
# YouTube - Get from https://console.cloud.google.com/
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=

# Instagram & Facebook - Get from https://developers.facebook.com/
INSTAGRAM_BUSINESS_ACCOUNT_ID=
INSTAGRAM_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=
FACEBOOK_ACCESS_TOKEN=

# X/Twitter - Get from https://developer.twitter.com/
TWITTER_BEARER_TOKEN=
TWITTER_API_KEY=
TWITTER_API_SECRET=