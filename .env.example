# Example environment variables for local development and Railway/Render deployment
# 
# DEPLOYMENT TARGETS:
# - Local Development: Copy this file to .env and fill in your local values
# - Railway: Set these variables in Railway Dashboard → Variables tab
# - Render: Use render.yaml envVars section or set in Render dashboard
#
# IMPORTANT: Never commit .env file with real secrets to git!

# ═══════════════════════════════════════════════════════════════════════════
# FLASK / SESSION SECURITY
# ═══════════════════════════════════════════════════════════════════════════

# IMPORTANT: Flask uses SECRET_KEY for session management (required!)
# Secret key for Flask session (min 32 chars for production)
# Generate: python -c "import secrets; print(secrets.token_hex(16))"
SECRET_KEY=change-me-to-a-secure-random-value

# Optional: Legacy admin secret key (if needed for custom auth)
# ADMIN_SECRET_KEY=additional-secret-if-needed

# Admin username for authentication (if using admin panel)
ADMIN_USERNAME=admin

# Password hash for admin (DO NOT use plaintext in production!)
# Generate hash: python -c "from werkzeug.security import generate_password_hash; print(generate_password_hash('YourPassword'))"
ADMIN_PASSWORD_HASH=

# Enable secure cookie flag in production (Railway/Render only)
# Local: false (HTTP), Production: true (HTTPS only)
ADMIN_COOKIE_SECURE=false

# ═══════════════════════════════════════════════════════════════════════════
# APPLICATION CONFIGURATION
# ═══════════════════════════════════════════════════════════════════════════

# Prevents Flask output buffering (recommended for logging)
PYTHONUNBUFFERED=true

# Flask environment mode
# Local: development, Production: production
FLASK_ENV=development

# Server port (used by Flask/Gunicorn)
# Railway/Render: Uses $PORT environment variable (auto-set)
# Local development: 5000 (if not set)
PORT=5000

# ═══════════════════════════════════════════════════════════════════════════
# MONGODB (Optional - for user profiles, orders, inventory)
# ═══════════════════════════════════════════════════════════════════════════

# MongoDB Atlas connection string (if using MongoDB)
# Format: mongodb+srv://username:password@cluster.mongodb.net/dbname?retryWrites=true
# Leave empty if not using MongoDB
MONGO_URI=

# ═══════════════════════════════════════════════════════════════════════════
# AI PROVIDERS (Google Gemini, OpenAI, Anthropic)
# ═══════════════════════════════════════════════════════════════════════════

# Google Gemini API Key (Required for DUCT AI)
# Get from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=

# OpenAI API Key (Optional - for GPT fallback)
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Anthropic Claude API Key (Optional - for Claude fallback)
# Get from: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# ═══════════════════════════════════════════════════════════════════════════
# AWS S3 STORAGE (For product images, documents, uploads)
# ═══════════════════════════════════════════════════════════════════════════

# AWS IAM Access Key ID (for programmatic S3 access)
# Create in: AWS Console → IAM → Users → [Your User] → Security Credentials
AWS_ACCESS_KEY_ID=

# AWS IAM Secret Access Key (KEEP SECURE!)
# Create alongside Access Key ID
AWS_SECRET_ACCESS_KEY=

# S3 bucket name (must exist and be accessible with above credentials)
# Example: interior-ecommerce-prod
AWS_S3_BUCKET_NAME=

# AWS region where bucket is located
# Examples: us-east-1, eu-west-1, ap-southeast-1
AWS_S3_REGION=us-east-1

# ═══════════════════════════════════════════════════════════════════════════
# PAYMENT PROVIDERS (Stripe, Paystack)
# ═══════════════════════════════════════════════════════════════════════════

# Stripe Payment Gateway (Optional)
# Get from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Paystack Payment Gateway (Optional)
# Get from: https://dashboard.paystack.com/settings/developer
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# ═══════════════════════════════════════════════════════════════════════════
# DEPLOYMENT-SPECIFIC SETTINGS
# ═══════════════════════════════════════════════════════════════════════════

# Railway-specific: Set to true in production
# RAILWAY_ENVIRONMENT=production

# Render-specific: Set to production
# RENDER_SERVICE_ID=<your-render-service-id>

# Allowed origins for CORS (comma-separated)
# Local: http://localhost:3000,http://localhost:5000
# Production: https://yourdomain.com,https://api.yourdomain.com
CORS_ORIGINS=http://localhost:3000,http://localhost:5000

# ═══════════════════════════════════════════════════════════════════════════
# NOTES FOR RAILWAY DEPLOYMENT
# ═══════════════════════════════════════════════════════════════════════════
#
# 1. Set variables in Railway Dashboard: Variables tab
# 2. Do NOT commit .env file with secrets to git
# 3. Use Railway's secret management for sensitive values
# 4. Test locally first: python application.py
# 5. Monitor logs: railway logs --follow
# 6. For S3 access from Railway, ensure AWS credentials have S3 permissions
# 7. For MongoDB from Railway, may need to whitelist Railway IPs in MongoDB Atlas
#
# See: RAILWAY_MIGRATION.md for complete setup instructions
